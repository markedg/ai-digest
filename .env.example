# Copy this file to .env and fill in your key.
# .env is gitignored; never commit your actual key.

YOUTUBE_API_KEY=your_key_here

# Optional overrides:
# DIGEST_OUTPUT_DIR=./output
# VIEW_THRESHOLD=5000           # min views for keyword-search candidates
# WINDOW_DAYS=14                # how far back to look (catches conference dumps)
# MIN_DURATION_SECONDS=180      # skip Shorts and short clips
# CLAUDE_MODEL=sonnet           # which Claude to use for the filter step
